{
	"name": "nylas-mail",
	"productName": "Nylas Mail",
	"version": "2.1.0",
	"private": true,
	"description": "The best email app for people and teams at work",
	"license": "GPL-3.0",
	"main": "./src/browser/main.js",
	"scripts": {
		"postinstall": "electron-builder install-app-deps",
		"prestart": "node scripts/build-renderer.js",
		"start": "electron . --dev --enable-logging",
		"test": "vitest run --coverage",
		"build:e2e": "node scripts/build-renderer.js && node scripts/dist.mjs host --dir",
		"e2e": "node e2e/run.mjs",
		"predist:mac": "node scripts/build-renderer.js",
		"dist:mac": "node scripts/dist.mjs mac",
		"predist:win": "node scripts/build-renderer.js",
		"dist:win": "node scripts/dist.mjs win",
		"predist:linux": "node scripts/dist.mjs linux --check-host && node scripts/build-renderer.js",
		"dist:linux": "node scripts/dist.mjs linux"
	},
	"dependencies": {
		"@electron/remote": "^2.1.3",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"async": "^3.2.6",
		"better-sqlite3": "^13.0.3",
		"bluebird": "^3.7.2",
		"chromium-net-errors": "^13.0.0",
		"chrono-node": "^2.10.1",
		"classnames": "^2.5.1",
		"client-sync": "workspace:*",
		"coffeestack": "^1.2.0",
		"color": "^5.0.3",
		"culori": "4.0.2",
		"debug": "^4.4.3",
		"emissary": "file:src/vendor/emissary",
		"emoji-data": "^0.2.0",
		"es6-weak-map": "^2.0.3",
		"esbuild": "^0.28.2",
		"event-kit": "file:src/vendor/event-kit",
		"fs-plus": "file:src/vendor/fs-plus",
		"getmac": "^6.6.0",
		"iconv-lite": "^0.7.0",
		"immutable": "^5.1.9",
		"is-online": "^12.0.2",
		"isomorphic-core": "file:../isomorphic-core",
		"jsonc-parser": "3.3.1",
		"kbpgp": "^2.1.18",
		"less-cache": "^1.1.1",
		"libmime": "^5.3.7",
		"lru-cache": "^11.5.2",
		"marked": "^18.0.11",
		"minimist": "^1.2.8",
		"mixto": "^1.0.0",
		"mkdirp": "^3.0.1",
		"moment": "^2.30.1",
		"moment-round": "^1.0.1",
		"moment-timezone": "^0.6.1",
		"mousetrap": "^1.6.5",
		"nock": "^14.0.17",
		"node-emoji": "^2.2.0",
		"optimist": "^0.6.1",
		"pick-react-known-prop": "^0.1.5",
		"promise-queue": "^2.2.5",
		"prop-types": "^15.8.1",
		"property-accessors": "^1.1.3",
		"q": "^1.5.1",
		"react": "^19.2.8",
		"react-dates": "^21.8.0",
		"react-dom": "^19.2.8",
		"react-transition-group": "^4.4.5",
		"reflux": "file:src/vendor/reflux",
		"reflux-core": "^1.0.0",
		"request-progress": "^3.0.0",
		"rimraf": "^6.0.1",
		"rx-lite": "^4.0.8",
		"rxjs": "^7.8.0",
		"sanitize-html": "^2.17.7",
		"semver": "^7.8.5",
		"source-map-support": "^0.5.21",
		"tldts": "^7.4.11",
		"underscore": "^1.13.8",
		"underscore-plus": "^1.7.0",
		"underscore.string": "^3.3.6",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@electron/fuses": "2.1.3",
		"@playwright/test": "1.64.1",
		"@testing-library/react": "^16.3.0",
		"@vitest/coverage-v8": "4.1.11",
		"electron": "45.3.1",
		"electron-builder": "26.18.1",
		"jsdom": "^30.0.1",
		"vitest": "4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nylas/nylas-mail.git"
	},
	"author": "Nylas",
	"engines": {
		"node": ">=24"
	}
}
